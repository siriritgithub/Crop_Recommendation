# Copy this file to .streamlit/secrets.toml and fill in your own keys.
# .streamlit/secrets.toml is git-ignored -- never commit real keys.

# Optional: enables live temperature/humidity lookup by city name in the
# Crop Recommendation and Irrigation tabs.
# Get a free key at https://openweathermap.org/api
OPENWEATHER_API_KEY = ""

# Optional: enables the AI Farm Assistant chatbot tab.
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY = ""
